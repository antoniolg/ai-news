---
import { formatUpdatedAt, getLatestPublishedDate } from "@/application/news/timeline";
import { loadTimelineGroups } from "@/infrastructure/news/loadNewsFromJson";
import "../styles/global.css";

const timelineGroups = loadTimelineGroups();
const hasNews = timelineGroups.some((group) => group.items.length > 0);
const timelineItems = timelineGroups.flatMap((group) => group.items);
const updatedAtLabel = formatUpdatedAt(getLatestPublishedDate(timelineItems));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Línea del tiempo de noticias de desarrollo con IA" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cambio de Estado</title>
  </head>
  <body class="bg-[#080a0c] text-neutral-100 antialiased">
    <main class="relative min-h-dvh overflow-hidden">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_48%_22%,rgba(31,41,55,0.32),transparent_32%),linear-gradient(180deg,rgba(255,255,255,0.02),transparent_30%)]"
      >
      </div>

      <section class="relative mx-auto min-h-dvh w-full max-w-[1500px] px-5 py-7 sm:px-8 lg:px-16">
        <header class="grid items-center gap-5 lg:grid-cols-[1fr_minmax(360px,580px)_1fr]">
          <a
            href="/"
            class="font-mono text-[1.35rem] font-bold leading-none text-neutral-100 sm:text-2xl"
            aria-label="Cambio de Estado"
          >
            Cambio de Estado<span class="ml-1 text-cyan-300">|</span>
          </a>

          <label class="relative block">
            <span class="sr-only">Buscar noticias</span>
            <span class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-neutral-600">
              <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none">
                <path
                  d="m21 21-4.35-4.35m1.35-5.15a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                ></path>
              </svg>
            </span>
            <input
              id="news-search"
              class="h-12 w-full rounded-lg border border-white/15 bg-white/[0.025] pl-14 pr-5 font-mono text-sm text-neutral-100 outline-none transition placeholder:text-neutral-500 focus:border-cyan-300/60 focus:bg-white/[0.045] focus:ring-4 focus:ring-cyan-300/10"
              type="search"
              placeholder="Buscar noticias..."
              autocomplete="off"
            />
          </label>

          <p class="flex items-center gap-3 justify-self-start font-mono text-sm text-neutral-400 lg:justify-self-end">
            <span class="size-2 rounded-full bg-lime-400 shadow-[0_0_18px_rgba(163,230,53,0.8)]"></span>
            {updatedAtLabel}
          </p>
        </header>

        <section
          class="relative mx-auto mt-12 pb-12 lg:mt-16 lg:max-w-[980px]"
          aria-label="Línea del tiempo de noticias"
        >
          {
            hasNews ? (
              <div id="timeline" class="relative">
                <div class="absolute bottom-0 left-4 top-0 w-px bg-gradient-to-b from-lime-400/70 via-cyan-300/50 to-neutral-500/70 lg:left-1/2 lg:-translate-x-1/2" />

                <div class="space-y-10 lg:space-y-12">
                  {timelineGroups.map((group) => (
                    <section class="timeline-group relative" data-news-group>
                      <div class="relative mb-5 flex justify-start lg:justify-center">
                        <span
                          class:list={[
                            "relative z-20 ml-4 rounded-full border px-4 py-1 font-mono text-sm font-semibold lg:ml-0",
                            group.accent === "lime"
                              ? "border-lime-400/80 bg-[#080a0c] text-lime-300 shadow-[0_0_24px_rgba(163,230,53,0.16)]"
                              : "border-cyan-300/80 bg-[#080a0c] text-cyan-200 shadow-[0_0_24px_rgba(103,232,249,0.15)]",
                          ]}
                        >
                          {group.label}
                        </span>
                      </div>

                      <div class="space-y-8">
                        {group.items.map((item, itemIndex) => {
                          const side = itemIndex % 2 === 0 ? "right" : "left";

                          return (
                            <article
                              class:list={[
                                "timeline-item relative grid lg:grid-cols-[1fr_64px_1fr]",
                                side === "left" ? "lg:[&_.timeline-card]:col-start-1" : "lg:[&_.timeline-card]:col-start-3",
                              ]}
                              data-news-item
                              data-search-text={item.searchText}
                            >
                              <span
                                aria-hidden="true"
                                class:list={[
                                  "absolute top-[2.125rem] hidden h-px bg-white/20 lg:block",
                                  side === "left"
                                    ? "left-[calc(50%-3.5rem)] w-14"
                                    : "left-1/2 w-14",
                                ]}
                              />
                              <div class="absolute left-4 top-7 z-10 size-5 -translate-x-1/2 rounded-full border border-cyan-300/70 bg-[#091014] p-1 shadow-[0_0_18px_rgba(34,211,238,0.38)] lg:left-1/2">
                                <span
                                  class:list={[
                                    "block size-full rounded-full",
                                    group.accent === "lime" ? "bg-lime-400" : "bg-cyan-300",
                                  ]}
                                />
                              </div>

                              <div
                                class:list={[
                                  "timeline-card relative ml-10 rounded-lg border border-white/10 bg-[#141516]/95 p-5 shadow-[0_18px_60px_rgba(0,0,0,0.32)] backdrop-blur transition duration-200 hover:-translate-y-0.5 hover:border-cyan-300/35 hover:bg-[#171819] lg:ml-0",
                                  side === "left" ? "lg:mr-6" : "lg:ml-6",
                                ]}
                              >
                                <div class="space-y-3">
                                  <h2 class="font-mono text-base font-bold leading-snug text-neutral-100">
                                    {item.title}
                                  </h2>
                                  <p class="font-mono text-sm leading-7 text-neutral-400">{item.summary}</p>
                                </div>

                                <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-4 font-mono text-sm">
                                  <p class="text-neutral-400">
                                    Fuente: <span class="text-neutral-300">{item.source}</span>
                                  </p>
                                  <a
                                    class="inline-flex items-center gap-2 font-semibold text-cyan-300 transition hover:text-cyan-100"
                                    href={item.url}
                                    target="_blank"
                                    rel="noreferrer"
                                  >
                                    Leer fuente
                                    <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none">
                                      <path
                                        d="M7 17 17 7m0 0H9m8 0v8"
                                        stroke="currentColor"
                                        stroke-width="1.8"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                      />
                                    </svg>
                                  </a>
                                </div>
                              </div>
                            </article>
                          );
                        })}
                      </div>
                    </section>
                  ))}
                </div>
              </div>
            ) : (
              <div class="mx-auto max-w-xl rounded-lg border border-white/10 bg-white/[0.03] p-8 text-center font-mono text-neutral-400">
                Todavía no hay noticias publicadas.
              </div>
            )
          }

          <div
            id="empty-search-state"
            class="mx-auto hidden max-w-xl rounded-lg border border-cyan-300/20 bg-cyan-300/[0.04] p-8 text-center font-mono text-neutral-300"
          >
            No hay noticias que coincidan con la búsqueda.
          </div>
        </section>
      </section>
    </main>

    <script>
      const searchInput = document.querySelector<HTMLInputElement>("#news-search");
      const newsItems = Array.from(document.querySelectorAll<HTMLElement>("[data-news-item]"));
      const newsGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-news-group]"));
      const emptySearchState = document.querySelector<HTMLElement>("#empty-search-state");

      const normalizeSearch = (value: string) =>
        value
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim();

      searchInput?.addEventListener("input", () => {
        const query = normalizeSearch(searchInput.value);
        let visibleItems = 0;

        for (const item of newsItems) {
          const searchText = item.dataset.searchText ?? "";
          const isVisible = !query || searchText.includes(query);
          item.style.display = isVisible ? "" : "none";

          if (isVisible) {
            visibleItems += 1;
          }
        }

        for (const group of newsGroups) {
          const groupItems = Array.from(group.querySelectorAll<HTMLElement>("[data-news-item]"));
          const isGroupVisible = groupItems.some((item) => item.style.display !== "none");
          group.style.display = isGroupVisible ? "" : "none";
        }

        if (emptySearchState) {
          emptySearchState.hidden = visibleItems > 0;
          emptySearchState.classList.toggle("hidden", visibleItems > 0);
        }
      });
    </script>
  </body>
</html>
