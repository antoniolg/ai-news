---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Línea del tiempo de noticias de desarrollo con IA" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Noticias IA Dev</title>
  </head>
  <body>
    <main class="min-h-dvh bg-neutral-950 text-neutral-50">
      <section class="mx-auto flex min-h-dvh max-w-3xl items-center justify-center px-6">
        <div class="space-y-4 text-center">
          <p class="text-sm uppercase tracking-[0.24em] text-neutral-500">Noticias IA Dev</p>
          <h1 class="text-4xl font-semibold tracking-normal sm:text-6xl">Hola mundo</h1>
          <p class="text-base leading-7 text-neutral-400">
            Scaffold mínimo listo para integración continua, despliegue y futuro trabajo de producto.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
